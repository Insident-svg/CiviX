NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/civix
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=120000
AI_RETRIES=2
AI_CONFIDENCE_THRESHOLD=0.75
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
MAIL_FROM_NAME=CiviX
MAIL_FROM_EMAIL=no-reply@your-verified-domain.example
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
PASSWORD_RESET_EXPIRES_MINUTES=30
MAX_FILE_SIZE_MB=20
INITIAL_ADMIN_GOVERNMENT_ID=CIVIX-ADMIN-001
INITIAL_ADMIN_NAME=CiviX Administrator
INITIAL_ADMIN_EMAIL=admin@civix.local
INITIAL_ADMIN_PASSWORD=replace-this-before-seeding

# Optional emergency triage assistance (fallback triage works without these)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
