<!doctype html>
<html>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify your CiviX email</title></head>
<body style="margin:0;background:#f5f7fb;font-family:Arial,sans-serif;color:#172033">
  <div style="max-width:600px;margin:40px auto;padding:32px;background:#fff;border-radius:16px">
    <h1 style="margin-top:0">Welcome to CiviX, <%= name %>!</h1>
    <p>Please verify your email address to activate your CiviX account.</p>
    <p><a href="<%= verificationUrl %>" style="display:inline-block;padding:12px 20px;background:#111827;color:#fff;text-decoration:none;border-radius:8px">Verify email address</a></p>
    <p style="font-size:14px;color:#667085">This link expires in <%= expiresMinutes %> minutes. If you did not create this account, you can ignore this email.</p>
  </div>
</body>
</html>
